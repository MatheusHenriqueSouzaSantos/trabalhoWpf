<UserControl x:Class="umfg.venda.app.UserControls.ucReceberPedido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:umfg.venda.app.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Pedido.Produtos}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Produtos" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Imagem}" Width="160" Height="150"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Descricao}" FontSize="24"/>
                                        <TextBlock Text="{Binding Referencia}" Grid.Column="1" FontSize="24" Margin="70 0 0 0" />
                                    </Grid>
                                    <TextBlock Text="{Binding Valor, StringFormat=R$ {0:F2}}" FontSize="24" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid  Grid.Column="1" Background="#F1F1F1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Width="600" Grid.Row="0" Text="Informações De Pagamento:" FontSize="22" FontWeight="Bold"/>
            <ComboBox 
                  Grid.Row="1"
                  FontSize="24" 
                  FontWeight="SemiBold" 
                  SelectedIndex="0" 
                  Width="600">
                <ComboBoxItem Content="Selecione um Cartão" IsEnabled="False"/>
                <ComboBoxItem Content="Cartão de Crédito"/>
                <ComboBoxItem Content="Cartão de Débito"/>
            </ComboBox>
            <StackPanel Orientation="Vertical" Grid.Row="2" Width="600">
                <TextBlock Text="Número do Cartão" FontSize="24" FontWeight="SemiBold"/>
                <TextBox 
                  Text="{Binding NumeroCartao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  FontSize="24"
                  FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="3"  Width="600">
                <TextBlock Text="Código CVV" FontSize="24" FontWeight="SemiBold"/>
                <TextBox 
                  Text="{Binding CVV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  FontSize="24"
                  FontWeight="SemiBold"/>

            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="4" Width="600">
                <TextBlock Text="Data de Validade (MM/yy)" FontSize="24" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox
                      Grid.Column="0"
                      FontSize="15"
                      ItemsSource="{Binding OpcoesDeMes}"
                      SelectedItem="{Binding MesSelecionado}"/>

                    <ComboBox
                      Margin="15 0 0 0"
                      Grid.Column="1"
                      FontSize="15"
                      ItemsSource="{Binding OpcoesDeAno}"
                      SelectedItem="{Binding AnoSelecionado}"/>
                </Grid>

            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="5" Width="600">
                <TextBlock Text="Nome no Cartão" FontSize="24" FontWeight="SemiBold"/>
                <TextBox 
                  Text="{Binding NomeCartao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  FontSize="24"
                  FontWeight="SemiBold"/>

            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="6" Width="300" Height="150" Margin="323 0 0 0">
                 <Button
                  Content="_Receber"
                  CommandParameter="{Binding}"
                  Command="{Binding FinalizarPagamento}"
                  Style="{StaticResource MaterialDesignRaisedLightButton}"
                  Margin="0 5 10 0 "
                  Background="#008000"
                  Foreground="White"
                  FontSize="18"
                  Height="40"/>

            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
